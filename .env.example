# Copy to `.env` (gitignored) and fill in. These two API keys are the ONLY
# secrets the app needs — `config.py` calls `load_dotenv()` so the SDKs pick
# them up. Everything else (models, retrieval knobs) is a plain constant in
# `nsa_chatbot/config.py`, not an env var.

# Anthropic — answers (Opus), follow-up query rewrite (Haiku), discovery agent.
ANTHROPIC_API_KEY=

# OpenAI — embeddings (text-embedding-3-large), for build + query.
OPENAI_API_KEY=
